# URL base usada pelo front para chamar a API.
# O padrão "/api" passa pelo proxy do Vite (recomendado, funciona também no celular).
VITE_API_URL=/api

# Para onde o proxy do Vite encaminha "/api" (a API Fatec Mission).
API_PROXY_TARGET=http://localhost:3000

# "true" usa uma API simulada no navegador (sem back-end). Também disponível via "npm run dev:mock".
VITE_USE_MOCK=false
